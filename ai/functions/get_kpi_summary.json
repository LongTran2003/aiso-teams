{
  "name": "GetKpiSummary",
  "description": "Get aggregated KPI dashboard overview from SAP. All params optional.",
  "parameters": {
    "type": "object",
    "properties": {
      "fromDate": {
        "type": ["string", "null"],
        "format": "date",
        "description": "Start date YYYY-MM-DD."
      },
      "toDate": {
        "type": ["string", "null"],
        "format": "date",
        "description": "End date YYYY-MM-DD."
      },
      "salesOrg": {
        "type": ["string", "null"],
        "enum": ["UE00", "UW00", "DN00", "DS00", null],
        "description": "Sales org."
      },
      "granularity": {
        "type": ["string", "null"],
        "enum": ["daily", "weekly", "monthly", null],
        "description": "Granularity for revenue series breakdown."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
