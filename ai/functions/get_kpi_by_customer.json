{
  "name": "GetKpiByCustomer",
  "description": "Get KPI metrics per customer (revenue, performance). All params optional.",
  "parameters": {
    "type": "object",
    "properties": {
      "customerIdOrName": {
        "type": ["string", "null"],
        "description": "Customer ID or partial name (e.g. 'CUST-3001')."
      },
      "fromDate": {
        "type": ["string", "null"],
        "format": "date",
        "description": "Start date YYYY-MM-DD."
      },
      "toDate": {
        "type": ["string", "null"],
        "format": "date",
        "description": "End date YYYY-MM-DD."
      },
      "salesOrg": {
        "type": ["string", "null"],
        "enum": ["UE00", "UW00", "DN00", "DS00", null],
        "description": "Sales org."
      },
      "top": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 50,
        "description": "Top N customers by revenue."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
