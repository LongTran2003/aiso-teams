{
  "name": "GetSalesOrders",
  "description": "Retrieve sales orders list from SAP based on optional filters. All params optional. Do NOT use for pending approvals / approval inbox — use GetPendingApprovals instead.",
  "parameters": {
    "type": "object",
    "properties": {
      "customerIdOrName": {
        "type": ["string", "null"],
        "description": "Customer ID or partial customer name (e.g. 'Philly Bikes')."
      },
      "fromDate": {
        "type": ["string", "null"],
        "format": "date",
        "description": "Start date YYYY-MM-DD."
      },
      "toDate": {
        "type": ["string", "null"],
        "format": "date",
        "description": "End date YYYY-MM-DD."
      },
      "status": {
        "type": ["string", "null"],
        "enum": ["Open", "Blocked", "PartiallyDelivered", "Delivered", "Invoiced", "Cancelled", null],
        "description": "Order status filter."
      },
      "salesOrg": {
        "type": ["string", "null"],
        "enum": ["UE00", "UW00", "DN00", "DS00", null],
        "description": "Sales organization code filter."
      },
      "top": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 50,
        "description": "Max records to return."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
