{
  "name": "GetKpiByProduct",
  "description": "Get KPI metrics per product (revenue, quantity sold). All params optional.",
  "parameters": {
    "type": "object",
    "properties": {
      "materialIdOrName": {
        "type": ["string", "null"],
        "description": "Material ID or product name (e.g. 'TG11')."
      },
      "fromDate": {
        "type": ["string", "null"],
        "format": "date",
        "description": "Start date YYYY-MM-DD."
      },
      "toDate": {
        "type": ["string", "null"],
        "format": "date",
        "description": "End date YYYY-MM-DD."
      },
      "salesOrg": {
        "type": ["string", "null"],
        "enum": ["UE00", "UW00", "DN00", "DS00", null],
        "description": "Sales org."
      },
      "top": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 50,
        "description": "Top N products by revenue."
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
