{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "size": "Large",
      "weight": "Bolder",
      "text": "👋 Hello! I am AISO Bot",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "An AI-powered SAP sales order management system integrated with Microsoft Teams.",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Account:", "value": "${username}" },
        { "title": "Status:", "value": "🟢 Connected to SAP S40 system" }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "View Recent Orders",
      "data": {
        "msteams": { "type": "imBack", "value": "recent orders" }
      }
    }
  ]
}