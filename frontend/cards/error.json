{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Attention",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "${title}",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Attention",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${summary}",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Error code", "value": "${errorCode}" },
        { "title": "Details", "value": "${errorMessage}" }
      ],
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Type help for example commands, or try again in a moment. Contact your admin if this keeps happening.",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Large"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Show help",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "help",
          "text": "help"
        }
      }
    }
  ]
}
