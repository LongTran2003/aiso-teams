{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Attention",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Reject approval request",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Attention"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Reject the pending release request for sales order ${salesOrderNumber}? This does not reject the sales order in SAP — it only declines the approval request.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "Input.Text",
      "id": "comment",
      "placeholder": "Reason for rejecting the approval...",
      "isMultiline": true,
      "isRequired": true,
      "errorMessage": "Please provide a reason"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Confirm reject approval",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Reject approval ${salesOrderNumber}",
          "text": "reject approval ${salesOrderNumber}"
        },
        "action": "reject_approval_confirm",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
