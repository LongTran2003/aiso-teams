{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Warning",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Force release (Admin)",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Warning",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Sales order ${salesOrderNumber}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "This bypasses ownership and releases the sales order in SAP. Confirm only for emergencies.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "Input.Text",
      "id": "reason",
      "label": "Override reason",
      "isRequired": true,
      "errorMessage": "Please enter a reason",
      "isMultiline": true,
      "placeholder": "Why is Admin force-releasing this order?",
      "value": "${reason}"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Confirm force release",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm force release ${salesOrderNumber}",
          "text": "force release ${salesOrderNumber}"
        },
        "action": "force_release_confirm",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
