{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Good",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "✅ Action completed successfully",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Good"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "The requested action has been completed successfully.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Sales Order:", "value": "${salesOrderNumber}" },
        { "title": "Status:", "value": "${status}" }
      ],
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "View Details",
      "data": {
        "action": "view_details",
        "salesOrderId": "${salesOrderNumber}"
      }
    }
  ]
}