{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Good",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Action completed",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Good",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "The requested action finished successfully.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Sales order", "value": "${salesOrderNumber}" },
        { "title": "Status", "value": "${status}" }
      ],
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "View details",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "View order details",
          "text": "view order ${salesOrderNumber}"
        },
        "action": "view_details",
        "salesOrderId": "${salesOrderNumber}"
      }
    }
  ]
}