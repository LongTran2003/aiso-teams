{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Good",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Confirm action",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Good"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Are you sure you want to approve and release sales order ${salesOrderNumber}?",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "This will trigger standard fulfillment in SAP.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "Input.Text",
      "id": "comment",
      "placeholder": "Enter approval comment (optional)...",
      "isMultiline": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Confirm Approve",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm approve order ${salesOrderNumber}",
          "text": "release order ${salesOrderNumber}"
        },
        "action": "release_so_confirm",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
