{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Emphasis",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Welcome to AISO",
          "weight": "Bolder",
          "size": "Large",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Sales order assistant for SAP S/4HANA in Microsoft Teams",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Hello, ${username}.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Link your **SAP User ID** once to review orders, request release, and run KPIs. Your admin assigns the ID in advance — use that ID (format `DEV-xxx`), not your Teams display name.",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        { "title": "Status", "value": "Ready — send any message to start linking if needed" }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Get started",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "help",
          "text": "help"
        }
      }
    }
  ]
}
