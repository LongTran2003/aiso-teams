{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "size": "Large",
      "weight": "Bolder",
      "text": "Hello, I’m AISO Bot",
      "color": "Accent",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "I can help you review sales orders and answer SAP-related questions in Microsoft Teams.",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Name", "value": "${username}" },
        { "title": "Status", "value": "Ready to help" }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "View recent orders",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "View recent orders",
          "text": "recent orders"
        }
      }
    }
  ]
}