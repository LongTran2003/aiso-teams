{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Emphasis",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Xac nhan don hang",
          "weight": "Bolder",
          "size": "Medium",
          "wrap": true
        }
      ]
    },
    {
      "type": "FactSet",
      "spacing": "Small",
      "facts": [
        { "title": "Sales Area", "value": "${salesAreaLabel}" },
        { "title": "Customer", "value": "${customerLabel}" },
        { "title": "Ship-to", "value": "${shipToParty}" },
        { "title": "Order type", "value": "${docType}" },
        { "title": "Currency", "value": "${currency}" },
        { "title": "PO Number", "value": "${purchaseOrderRef}" },
        { "title": "Delivery Date", "value": "${requestedDeliveryDate}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Items",
      "weight": "Bolder",
      "size": "Small",
      "spacing": "Medium",
      "wrap": true
    },
        {
          "type": "Container",
          "spacing": "Small",
          "items": [
            {
              "type": "FactSet",
              "facts": [
                { "$data": "${lineItems}", "title": "${Material}", "value": "Qty ${Qty}  Plant: ${Plant}  Unit: ${Unit}" }
              ]
            }
          ]
        },
    {
      "type": "Input.Text",
      "id": "lineItemsJson",
      "value": "${lineItemsJson}",
      "isVisible": false
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Confirm & Create",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm and create order",
          "text": "create order"
        },
        "action": "create_so_confirm",
        "salesArea": "${salesAreaKey}",
        "salesOrg": "${salesOrg}",
        "distChannel": "${distChannel}",
        "division": "${division}",
        "docType": "${docType}",
        "currency": "${currency}",
        "purchaseOrderRef": "${purchaseOrderRef}",
        "requestedDeliveryDate": "${requestedDeliveryDate}",
        "shipToParty": "${shipToParty}",
        "customer": "${customerId}",
        "customerLabel": "${customerLabel}",
        "lineItemsJson": "${lineItemsJson}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Back",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Back to items",
          "text": "Back"
        },
        "action": "create_so_step3_submit",
        "salesArea": "${salesAreaKey}",
        "salesOrg": "${salesOrg}",
        "distChannel": "${distChannel}",
        "division": "${division}",
        "docType": "${docType}",
        "currency": "${currency}",
        "purchaseOrderRef": "${purchaseOrderRef}",
        "requestedDeliveryDate": "${requestedDeliveryDate}",
        "shipToParty": "${shipToParty}",
        "customer": "${customerId}",
        "customerLabel": "${customerLabel}",
        "_back": "true"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}