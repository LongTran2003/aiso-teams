{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "KPI Summary",
      "weight": "Bolder",
      "size": "Medium",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "${period}",
      "isSubtle": true,
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Revenue",
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${revenueValue}",
              "size": "Large",
              "color": "Good"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Orders",
              "weight": "Bolder"
            },
            {
              "type": "TextBlock",
              "text": "${orderCount}",
              "size": "Large"
            }
          ]
        }
      ]
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        {
          "title": "Open",
          "value": "${openOrders}"
        },
        {
          "title": "Delivered",
          "value": "${deliveredOrders}"
        },
        {
          "title": "Overdue",
          "value": "${overdueOrders}"
        },
        {
          "title": "Fulfillment rate",
          "value": "${fulfillmentRate}"
        }
      ]
    },
    {
      "type": "Image",
      "url": "${chartUrl}",
      "altText": "Revenue trend chart",
      "spacing": "Medium",
      "horizontalAlignment": "Center",
      "size": "Medium",
      "width": "500px",
      "height": "300px",
      "$when": "${chartUrl != ''}",
      "selectAction": {
      "type": "Action.OpenUrl",
      "url": "${chartUrl}"
      }
    }
  ]
}
