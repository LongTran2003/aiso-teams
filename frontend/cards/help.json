{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "How to use AISO",
      "weight": "Bolder",
      "size": "Large",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "New here? Follow the flow for your role, then use a shortcut or type a short command in English or Vietnamese (one language per message).",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "$when": "${role == 'Employee'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Employee flow (release request)",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "1. Show your orders (list or open orders)\n2. Open **View details** on the order you own\n3. Tap **Request release** → confirm\n4. Wait for a Manager — status stays Open with **Approval: Waiting**\n5. Optional: **Reject** or **Forward** only on orders you own",
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "$when": "${role == 'Manager'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Manager flow (approve release)",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "1. Open **Pending approvals**\n2. Review the order → **View details** if needed\n3. **Approve** (releases in SAP) or **Reject approval** (keeps order, clears pending)\n4. On detail you can also **Cancel order** (cancels SO in SAP)\n5. You can also browse orders / KPIs anytime",
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "$when": "${role == 'Admin'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Admin flow",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "1. **List users** → Manage to set Role / SalesOrg (confirm card)\n2. **View audit log** for who did what\n3. Force release / force cancel only for emergencies\n4. Manage approval delegation for Managers",
          "wrap": true,
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Shortcuts",
      "weight": "Bolder",
      "spacing": "Medium",
      "$when": "${role == 'Employee'}"
    },
    {
      "type": "ActionSet",
      "$when": "${role == 'Employee'}",
      "actions": [
        { "type": "Action.Submit", "title": "Recent orders", "data": { "msteams": { "type": "messageBack", "displayText": "Recent orders", "text": "recent orders" } } },
        { "type": "Action.Submit", "title": "My Orders", "data": { "msteams": { "type": "messageBack", "displayText": "My Orders", "text": "show my sales orders" } } },
        { "type": "Action.Submit", "title": "My profile", "data": { "msteams": { "type": "messageBack", "displayText": "My profile", "text": "my profile" } } },
        { "type": "Action.Submit", "title": "Revenue KPI", "data": { "msteams": { "type": "messageBack", "displayText": "Revenue KPI", "text": "show revenue kpi" } } },
        { "type": "Action.Submit", "title": "Request release", "data": { "msteams": { "type": "messageBack", "displayText": "Request release", "text": "request release" } } },
        { "type": "Action.Submit", "title": "Create order", "data": { "msteams": { "type": "messageBack", "displayText": "Create order", "text": "create order" } } }
      ],
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Shortcuts",
      "weight": "Bolder",
      "spacing": "Medium",
      "$when": "${role == 'Manager'}"
    },
    {
      "type": "ActionSet",
      "$when": "${role == 'Manager'}",
      "actions": [
        { "type": "Action.Submit", "title": "Pending approvals", "data": { "msteams": { "type": "messageBack", "displayText": "Pending approvals", "text": "show pending approvals" } } },
        { "type": "Action.Submit", "title": "Approve order", "data": { "msteams": { "type": "messageBack", "displayText": "Approve order", "text": "approve order" } } },
        { "type": "Action.Submit", "title": "Reject approval", "data": { "msteams": { "type": "messageBack", "displayText": "Reject approval", "text": "reject approval" } } },
        { "type": "Action.Submit", "title": "Delegate approval", "data": { "msteams": { "type": "messageBack", "displayText": "Delegate approval", "text": "delegate approval" } } },
        { "type": "Action.Submit", "title": "My delegations", "data": { "msteams": { "type": "messageBack", "displayText": "My delegations", "text": "list my delegations" } } }
      ],
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Shortcuts",
      "weight": "Bolder",
      "spacing": "Medium",
      "$when": "${role == 'Admin'}"
    },
    {
      "type": "ActionSet",
      "$when": "${role == 'Admin'}",
      "actions": [
        { "type": "Action.Submit", "title": "List users", "data": { "msteams": { "type": "messageBack", "displayText": "List users", "text": "list users" } } },
        { "type": "Action.Submit", "title": "View audit log", "data": { "msteams": { "type": "messageBack", "displayText": "View audit log", "text": "view audit log" } } },
        { "type": "Action.Submit", "title": "Force release", "data": { "msteams": { "type": "messageBack", "displayText": "Force release", "text": "force release" } } }
      ],
      "spacing": "Small"
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "selectAction": {
        "type": "Action.ToggleVisibility",
        "targetElements": ["commands-section", "chevron-down", "chevron-up"]
      },
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "id": "chevron-down",
                  "text": "▸",
                  "weight": "Bolder",
                  "size": "Medium"
                },
                {
                  "type": "TextBlock",
                  "id": "chevron-up",
                  "text": "▾",
                  "weight": "Bolder",
                  "size": "Medium",
                  "isVisible": false
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "All commands you can say (${role})",
                  "weight": "Bolder",
                  "wrap": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "id": "commands-section",
      "spacing": "Medium",
      "isVisible": false,
      "$when": "${hasCommands == 'true'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Tap a heading to expand · arranged by flow",
          "isSubtle": true,
          "size": "Small",
          "wrap": true,
          "spacing": "Small"
        },
        {
          "type": "Container",
          "$data": "${commands}",
          "items": [
            {
              "type": "TextBlock",
              "text": "${icon} ${en}  ·  ${vi}",
              "wrap": true,
              "fontType": "Monospace",
              "size": "Small",
              "spacing": "Small"
            },
            {
              "type": "TextBlock",
              "text": "${note}",
              "isSubtle": true,
              "wrap": true,
              "size": "Small",
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Tip: Prefer one language per message. Card buttons stay in English. Vietnamese like hướng dẫn / trợ giúp also opens this card.",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Large"
    }
  ]
}