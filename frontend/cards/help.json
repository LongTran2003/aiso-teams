{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "SUPPORTED COMMANDS",
      "weight": "Bolder",
      "size": "Medium",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "Type a sample below in English (natural phrasing also works). Use the shortcuts for common actions.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Commands for Employee",
      "weight": "Bolder",
      "spacing": "Medium",
      "color": "Good",
      "$when": "${role == 'Employee'}"
    },
    {
      "type": "ActionSet",
      "$when": "${role == 'Employee'}",
      "actions": [
        {
          "type": "Action.Submit",
          "title": "Recent Orders",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "Recent Orders",
              "text": "recent orders"
            }
          }
        },
        {
          "type": "Action.Submit",
          "title": "My Orders",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "My Orders",
              "text": "show my sales orders"
            }
          }
        },
        {
          "type": "Action.Submit",
          "title": "Revenue KPI",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "Revenue KPI",
              "text": "show revenue kpi"
            }
          }
        },
        {
          "type": "Action.Submit",
          "title": "Request Release",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "Request Release",
              "text": "request release"
            }
          }
        }
      ],
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Example commands",
      "weight": "Bolder",
      "spacing": "Medium",
      "size": "Small",
      "$when": "${role == 'Employee'}"
    },
    {
      "type": "TextBlock",
      "text": "• recent orders\n• show my sales orders\n• show open orders\n• show orders of TV01\n• show open orders of FU24\n• show order 13122\n• show overdue orders\n• show revenue kpi\n• kpi by customer 1000\n• kpi by product MAT-01\n• request release 13122\n• reject order 13122\n• forward order 13122 to DEV-xxx\n• help · logout",
      "wrap": true,
      "spacing": "Small",
      "fontType": "Monospace",
      "size": "Small",
      "$when": "${role == 'Employee'}"
    },
    {
      "type": "TextBlock",
      "text": "Commands for Manager",
      "weight": "Bolder",
      "spacing": "Medium",
      "color": "Attention",
      "$when": "${role == 'Manager'}"
    },
    {
      "type": "ActionSet",
      "$when": "${role == 'Manager'}",
      "actions": [
        {
          "type": "Action.Submit",
          "title": "Pending Approvals",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "Pending Approvals",
              "text": "show pending approvals"
            }
          }
        },
        {
          "type": "Action.Submit",
          "title": "Approve Order",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "Approve Order",
              "text": "approve order"
            }
          }
        },
        {
          "type": "Action.Submit",
          "title": "Reject Approval",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "Reject Approval",
              "text": "reject approval"
            }
          }
        }
      ],
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Example commands",
      "weight": "Bolder",
      "spacing": "Medium",
      "size": "Small",
      "$when": "${role == 'Manager'}"
    },
    {
      "type": "TextBlock",
      "text": "• show pending approvals\n• approve order 13122\n• reject approval 13122\n• release order 13122\n• recent orders\n• show open orders of TV01\n• show order 13122\n• show overdue orders\n• show revenue kpi\n• help · logout",
      "wrap": true,
      "spacing": "Small",
      "fontType": "Monospace",
      "size": "Small",
      "$when": "${role == 'Manager'}"
    },
    {
      "type": "TextBlock",
      "text": "Commands for Admin",
      "weight": "Bolder",
      "spacing": "Medium",
      "color": "Accent",
      "$when": "${role == 'Admin'}"
    },
    {
      "type": "ActionSet",
      "$when": "${role == 'Admin'}",
      "actions": [
        {
          "type": "Action.Submit",
          "title": "View Audit Log",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "View Audit Log",
              "text": "view audit log"
            }
          }
        },
        {
          "type": "Action.Submit",
          "title": "Manage Approval Flow",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "Manage Approval Flow",
              "text": "show pending approvals"
            }
          }
        },
        {
          "type": "Action.Submit",
          "title": "Revenue KPI",
          "data": {
            "msteams": {
              "type": "messageBack",
              "displayText": "Revenue KPI",
              "text": "show revenue kpi"
            }
          }
        }
      ],
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Example commands",
      "weight": "Bolder",
      "spacing": "Medium",
      "size": "Small",
      "$when": "${role == 'Admin'}"
    },
    {
      "type": "TextBlock",
      "text": "• view audit log\n• show pending approvals\n• force release 13122\n• force cancel 13122\n• recent orders\n• show open orders of TV01\n• show order 13122\n• show revenue kpi\n• help · logout",
      "wrap": true,
      "spacing": "Small",
      "fontType": "Monospace",
      "size": "Small",
      "$when": "${role == 'Admin'}"
    },
    {
      "type": "TextBlock",
      "text": "Tip: Prefer one language per message (e.g. show open orders of TV01). Avoid mixing English and Vietnamese in the same line.",
      "wrap": true,
      "isSubtle": true,
      "size": "Small",
      "spacing": "Large"
    }
  ]
}
