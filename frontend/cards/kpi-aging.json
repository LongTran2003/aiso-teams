{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "⏳ Sales Order Aging",
      "weight": "Bolder",
      "size": "Medium",
      "color": "Accent"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Overdue Orders:", "value": "${overdueCount}" },
        { "title": "Aging > 30 days:", "value": "${aging30Count}" },
        { "title": "Total Value:", "value": "${agingTotalValue}" }
      ],
      "spacing": "Medium"
    },
    {
      "type": "Image",
      "url": "${chartUrl}",
      "altText": "Aging chart",
      "spacing": "Medium",
      "horizontalAlignment": "Center",
      "$when": "${chartUrl != ''}"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Review Aging Orders",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Review Aging Orders",
          "text": "show aging kpi"
        }
      }
    }
  ]
}