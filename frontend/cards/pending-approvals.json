{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "Pending approvals",
              "size": "Large",
              "weight": "Bolder",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "${count} release request(s) waiting for your approval",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "wrap": true
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "Emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Filters",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "Input.Text",
          "id": "search",
          "label": "Order, requester, or comment",
          "placeholder": "e.g. 0000000009 or DEV-024",
          "value": "${search}"
        },
        {
          "type": "Input.ChoiceSet",
          "id": "requester",
          "label": "Requested by",
          "style": "compact",
          "value": "${selectedRequester}",
          "choices": [
            {
              "title": "All requesters",
              "value": ""
            },
            {
              "$data": "${requesterChoices}",
              "title": "${title}",
              "value": "${value}"
            }
          ]
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Apply filters",
              "data": {
                "msteams": {
                  "type": "messageBack",
                  "displayText": "Filter pending approvals",
                  "text": "filter pending approvals"
                },
                "action": "filter_pending_approvals"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "No approvals match the selected filters.",
      "isSubtle": true,
      "wrap": true,
      "spacing": "Medium",
      "$when": "${count == 0}"
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "Medium",
      "$data": "${items}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "Input.Toggle",
                  "id": "toggle_${orderId}",
                  "title": "",
                  "value": "false"
                }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${orderId}",
                  "weight": "Bolder",
                  "size": "Medium",
                  "wrap": true,
                  "spacing": "None"
                },
                {
                  "type": "TextBlock",
                  "text": "By ${requestedBy}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${comment}",
                  "size": "Small",
                  "wrap": true,
                  "spacing": "Small",
                  "$when": "${comment != ''}"
                },
                {
                  "type": "TextBlock",
                  "text": "Requested ${requestedAt}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                }
              ]
            }
          ]
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "View details",
              "data": {
                "msteams": {
                  "type": "messageBack",
                  "displayText": "View order ${orderId}",
                  "text": "view order ${orderId}"
                },
                "action": "view_details",
                "salesOrderId": "${orderId}"
              }
            },
            {
              "type": "Action.Submit",
              "title": "Approve",
              "style": "positive",
              "data": {
                "msteams": {
                  "type": "messageBack",
                  "displayText": "Approve order ${orderId}",
                  "text": "approve order ${orderId}"
                },
                "action": "approve_so",
                "salesOrderId": "${orderId}"
              }
            },
            {
              "type": "Action.Submit",
              "title": "Reject approval",
              "style": "destructive",
              "data": {
                "msteams": {
                  "type": "messageBack",
                  "displayText": "Reject approval ${orderId}",
                  "text": "reject approval ${orderId}"
                },
                "action": "reject_approval",
                "salesOrderId": "${orderId}"
              }
            }
          ],
          "spacing": "Small"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Large",
      "$when": "${count > 0}",
      "items": [
        {
          "type": "Input.Text",
          "id": "bulk_comment",
          "label": "Comment (optional)",
          "placeholder": "Enter a comment for selected orders"
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "Approve Selected",
              "style": "positive",
              "data": {
                "msteams": {
                  "type": "messageBack",
                  "displayText": "Bulk approve selected orders",
                  "text": "bulk approve selected orders"
                },
                "action": "bulk_approve_so"
              }
            }
          ]
        }
      ]
    }
  ]
}
