{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Forward sales order",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "You are about to forward sales order ${salesOrderNumber} to another reviewer.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Sender: ${senderName}",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "TextBlock",
      "text": "Select a recipient and add an optional note.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "forwardToUser",
      "label": "Recipient",
      "isRequired": true,
      "errorMessage": "Please select a recipient",
      "style": "compact",
      "choices": [
        {
          "title": "${recipientChoice.title}",
          "value": "${recipientChoice.value}"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "comment",
      "placeholder": "Optional note for the recipient",
      "isMultiline": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Send",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Forward order ${salesOrderNumber}",
          "text": "forward order ${salesOrderNumber}"
        },
        "action": "forward_so_confirm",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
