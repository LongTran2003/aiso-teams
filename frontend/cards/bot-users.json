{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Bot users",
      "size": "Large",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${count} linked account(s) — Admin can change Role / SalesOrg",
      "size": "Small",
      "isSubtle": true,
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "Container",
      "separator": true,
      "$data": "${users}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${displayName}",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${sapUserId} · ${role} · ${salesOrgLabel}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    {
                      "type": "Action.Submit",
                      "title": "Manage",
                      "data": {
                        "msteams": {
                          "type": "messageBack",
                          "displayText": "Manage ${sapUserId}",
                          "text": "manage user ${sapUserId}"
                        },
                        "action": "manage_bot_user",
                        "sapUserId": "${sapUserId}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
