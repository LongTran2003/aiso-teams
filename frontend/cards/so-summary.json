{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "size": "Large",
              "weight": "Bolder",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "${count} order(s) found",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None",
              "wrap": true
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "Medium",
      "$data": "${orders}",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "Medium",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${soNumber}",
                  "weight": "Bolder",
                  "size": "Medium",
                  "wrap": true,
                  "spacing": "None"
                },
                {
                  "type": "TextBlock",
                  "text": "${customerName}",
                  "size": "Small",
                  "wrap": true,
                  "spacing": "None"
                },
                {
                  "type": "TextBlock",
                  "text": "${orderDate} | ${salesOrg}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${formattedValue}",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right",
                  "wrap": true,
                  "spacing": "None"
                },
                {
                  "type": "TextBlock",
                  "text": "${status}",
                  "size": "Small",
                  "weight": "Bolder",
                  "color": "${statusColor}",
                  "horizontalAlignment": "Right",
                  "spacing": "None",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${statusHint}",
                  "size": "Small",
                  "isSubtle": true,
                  "horizontalAlignment": "Right",
                  "spacing": "None",
                  "wrap": true,
                  "$when": "${showStatusHint == 'true'}"
                }
              ]
            }
          ]
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "View details",
              "data": {
                "msteams": {
                  "type": "messageBack",
                  "displayText": "View order ${soNumber}",
                  "text": "view order ${soNumber}"
                },
                "action": "view_details",
                "salesOrderId": "${soNumber}"
              }
            }
          ],
          "spacing": "Small"
        }
      ]
    }
  ]
}
