{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "📋 Sales Orders",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${count} order(s) found",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium",
      "wrap": true
    },
    {
      "type": "Container",
      "separator": true,
      "$data": "${orders}",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${soNumber}",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${customerName}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${formattedValue}",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${status}",
                  "size": "Small",
                  "color": "${statusColor}",
                  "horizontalAlignment": "Right",
                  "spacing": "None",
                  "wrap": true
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${orderDate} · ${salesOrg}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        },
        {
          "type": "ActionSet",
          "actions": [
            {
              "type": "Action.Submit",
              "title": "View Details",
              "data": {
                "msteams": {
                  "type": "messageBack",
                  "displayText": "View Order Details",
                  "text": "view order ${soNumber}"
                },
                "action": "view_details",
                "salesOrderId": "${soNumber}"
              }
            }
          ],
          "spacing": "Small"
        }
      ]
    }
  ]
}
