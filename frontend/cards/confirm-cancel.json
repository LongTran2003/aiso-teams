{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Attention",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Confirm cancel",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Attention",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Sales order ${salesOrderNumber}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "This cancels the sales order in SAP. Any pending release approval for this order will be cleared.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "Input.Text",
      "id": "reason",
      "label": "Reason (optional)",
      "isRequired": false,
      "isMultiline": true,
      "placeholder": "Why are you cancelling this order?",
      "value": "${reason}"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Confirm cancel",
      "style": "destructive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm cancel order ${salesOrderNumber}",
          "text": "cancel order ${salesOrderNumber}"
        },
        "action": "cancel_so_confirm",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Back",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
