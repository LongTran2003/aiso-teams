{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Link SAP account",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "One-time setup for ${displayName}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Enter the **SAP User ID** your admin assigned to this Teams account. You cannot link someone else's ID.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Your assigned ID", "value": "${assignedSapUserId}" }
      ],
      "spacing": "Small",
      "$when": "${hasAssignedId == 'true'}"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Format", "value": "DEV-xxx (letters, digits, hyphen)" }
      ],
      "spacing": "Small",
      "$when": "${hasAssignedId != 'true'}"
    },
    {
      "type": "TextBlock",
      "text": "${errorMessage}",
      "color": "Attention",
      "wrap": true,
      "spacing": "Medium",
      "$when": "${hasError == 'true'}"
    },
    {
      "type": "TextBlock",
      "text": "Type your assigned SAP User ID in the chat box below, then press Enter.",
      "size": "Small",
      "isSubtle": true,
      "wrap": true,
      "spacing": "Medium"
    }
  ]
}
