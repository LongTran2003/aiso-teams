{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Attention",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Not authorized",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Attention",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${errorMessage}",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Your role", "value": "${currentRole}" },
        { "title": "Required", "value": "${requiredRole}" }
      ],
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Type help to see example commands for your role (e.g. recent orders · show pending approvals · request release 13122).",
      "size": "Small",
      "isSubtle": true,
      "wrap": true,
      "spacing": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Show help",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "help",
          "text": "help"
        }
      }
    }
  ]
}
