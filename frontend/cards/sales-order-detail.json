{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "📦 SAP SALES ORDER DETAILS: ${salesOrderNumber}",
      "weight": "Bolder",
      "size": "Large",
      "color": "Accent",
      "wrap": true
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Customer:", "value": "${customerName} (${customerId})" },
        { "title": "Cust. Reference (PO):", "value": "${customerReference}" },
        { "title": "Sales Org / Division:", "value": "${salesOrg} / ${division}" },
        { "title": "Document Date:", "value": "${documentDate}" },
        { "title": "Req. Delivery Date:", "value": "${requestedDeliveryDate}" },
        { "title": "Net Value:", "value": "${netAmount} ${currency}" },
        { "title": "Approval Status:", "value": "${approvalStatus}" }
      ],
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Line Items:",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true,
      "wrap": true
    },
    {
      "type": "Container",
      "$data": "${items}",
      "items": [
        {
          "type": "TextBlock",
          "text": "• **Item ${itemNumber}**: ${description}\n  🔹 Qty: ${quantity} ${unit} | Plant: ${plant} | Amount: **${netValue} ${currency}**",
          "wrap": true,
          "spacing": "Small"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "✅ Approve (Release)",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Approve order ${salesOrderNumber}",
          "text": "release order ${salesOrderNumber}"
        },
        "action": "release_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "❌ Reject",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Reject order ${salesOrderNumber}",
          "text": "reject order ${salesOrderNumber}"
        },
        "action": "reject_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "🔁 Forward",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Forward order ${salesOrderNumber}",
          "text": "forward order ${salesOrderNumber}"
        },
        "action": "forward_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    }
  ]
}