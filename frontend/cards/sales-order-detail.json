{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Sales order",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${salesOrderNumber}",
                  "weight": "Bolder",
                  "size": "Large",
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${approvalStatus}",
                  "weight": "Bolder",
                  "color": "${statusColor}",
                  "horizontalAlignment": "Right",
                  "wrap": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        { "title": "Customer", "value": "${customerDisplay}" },
        { "title": "PO reference", "value": "${customerReference}" },
        { "title": "Sales org / Div.", "value": "${salesOrgDivision}" },
        { "title": "Document date", "value": "${documentDate}" },
        { "title": "Req. delivery", "value": "${requestedDeliveryDate}" },
        { "title": "Net value", "value": "${netAmount} ${currency}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Line items",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true,
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "No line items available yet.",
      "isSubtle": true,
      "wrap": true,
      "spacing": "Small",
      "$when": "${hasItems == 'false'}"
    },
    {
      "type": "Container",
      "$when": "${hasItems == 'true'}",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Item",
                  "size": "Small",
                  "isSubtle": true,
                  "weight": "Bolder",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "72",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Qty",
                  "size": "Small",
                  "isSubtle": true,
                  "weight": "Bolder",
                  "horizontalAlignment": "Right",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "120",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Amount",
                  "size": "Small",
                  "isSubtle": true,
                  "weight": "Bolder",
                  "horizontalAlignment": "Right",
                  "wrap": true
                }
              ]
            }
          ]
        },
        {
          "type": "Container",
          "$data": "${items}",
          "items": [
            {
              "type": "ColumnSet",
              "spacing": "Small",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${itemNumber} | ${material}",
                      "weight": "Bolder",
                      "wrap": true,
                      "spacing": "None"
                    },
                    {
                      "type": "TextBlock",
                      "text": "${currencyUnit}",
                      "size": "Small",
                      "isSubtle": true,
                      "wrap": true,
                      "spacing": "None"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "72",
                  "verticalContentAlignment": "Center",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${quantity} ${unit}",
                      "horizontalAlignment": "Right",
                      "wrap": true,
                      "spacing": "None"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "120",
                  "verticalContentAlignment": "Center",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${netValue} ${currency}",
                      "weight": "Bolder",
                      "horizontalAlignment": "Right",
                      "wrap": true,
                      "spacing": "None"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Request release",
      "style": "positive",
      "$when": "${showRequestRelease == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Request release ${salesOrderNumber}",
          "text": "request release ${salesOrderNumber}"
        },
        "action": "release_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Approve & release",
      "style": "positive",
      "$when": "${showApprove == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Approve order ${salesOrderNumber}",
          "text": "approve order ${salesOrderNumber}"
        },
        "action": "approve_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Reject order",
      "style": "destructive",
      "$when": "${showReject == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Reject order ${salesOrderNumber}",
          "text": "reject order ${salesOrderNumber}"
        },
        "action": "reject_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Forward",
      "$when": "${showForward == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Forward order ${salesOrderNumber}",
          "text": "forward order ${salesOrderNumber}"
        },
        "action": "forward_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    }
  ]
}
