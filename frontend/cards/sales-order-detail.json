{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Emphasis",
      "bleed": true,
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Sales order",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${salesOrderNumber}",
                  "weight": "Bolder",
                  "size": "Large",
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${approvalStatus}",
                  "weight": "Bolder",
                  "color": "${statusColor}",
                  "horizontalAlignment": "Right",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "${approvalHint}",
                  "size": "Small",
                  "isSubtle": true,
                  "horizontalAlignment": "Right",
                  "wrap": true,
                  "spacing": "None",
                  "$when": "${showApprovalHint == 'true'}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "attention",
      "spacing": "Medium",
      "$when": "${showInvalidMaterial == 'true'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Invalid material master data",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "One or more items reference a material that does not exist in SAP. You can view this order, but Request release / Reject / Forward / Approve are disabled.",
          "isSubtle": true,
          "wrap": true,
          "spacing": "None"
        }
      ]
    },
    {
      "type": "Container",
      "style": "good",
      "spacing": "Medium",
      "$when": "${showReleasedBanner == 'true'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${releasedBannerTitle}",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${releasedBannerMessage}",
          "isSubtle": true,
          "wrap": true,
          "spacing": "None",
          "$when": "${releasedBannerMessage != ''}"
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "$when": "${showOwnedBy == 'true'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Owned by ${ownedBySapUser}",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${ownedByMessage}",
          "isSubtle": true,
          "wrap": true,
          "spacing": "None"
        }
      ]
    },
    {
      "type": "Container",
      "style": "warning",
      "spacing": "Medium",
      "$when": "${showPendingEmployee == 'true'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Waiting for manager approval",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${pendingEmployeeMessage}",
          "isSubtle": true,
          "wrap": true,
          "spacing": "None"
        }
      ]
    },
    {
      "type": "Container",
      "style": "attention",
      "spacing": "Medium",
      "$when": "${showPendingManager == 'true'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Release request pending",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${pendingManagerSubmittedBy}",
          "wrap": true,
          "spacing": "Small"
        },
        {
          "type": "TextBlock",
          "text": "${pendingManagerNote}",
          "isSubtle": true,
          "wrap": true,
          "spacing": "None"
        }
      ]
    },
    {
      "type": "Container",
      "spacing": "Medium",
      "style": "emphasis",
      "$when": "${showApprovalJourney == 'true'}",
      "items": [
        {
          "type": "TextBlock",
          "text": "Approval journey",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Release request trail (who / when).",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        },
        {
          "type": "Container",
          "spacing": "Small",
          "$data": "${journeySteps}",
          "items": [
            {
              "type": "TextBlock",
              "text": "${title}",
              "weight": "Bolder",
              "wrap": true,
              "spacing": "Small"
            },
            {
              "type": "TextBlock",
              "text": "${detail}",
              "size": "Small",
              "isSubtle": true,
              "wrap": true,
              "spacing": "None"
            }
          ]
        }
      ]
    },
    {
      "type": "FactSet",
      "spacing": "Medium",
      "facts": [
        { "title": "Customer", "value": "${customerDisplay}" },
        { "title": "PO reference", "value": "${customerReference}" },
        { "title": "Sales org / Div.", "value": "${salesOrgDivision}" },
        { "title": "Document date", "value": "${documentDate}" },
        { "title": "Req. delivery", "value": "${requestedDeliveryDate}" },
        { "title": "Net value", "value": "${netAmount} ${currency}" }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Line items",
      "weight": "Bolder",
      "spacing": "Medium",
      "separator": true,
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "No line items available yet.",
      "isSubtle": true,
      "wrap": true,
      "spacing": "Small",
      "$when": "${hasItems == 'false'}"
    },
    {
      "type": "Container",
      "$when": "${hasItems == 'true'}",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Item",
                  "size": "Small",
                  "isSubtle": true,
                  "weight": "Bolder",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "200px",
              "items": [
                {
                  "type": "ColumnSet",
                  "columns": [
                    {
                      "type": "Column",
                      "width": "70px",
                      "items": [
                        {
                          "type": "TextBlock",
                          "text": "Qty",
                          "size": "Small",
                          "isSubtle": true,
                          "weight": "Bolder",
                          "horizontalAlignment": "Center",
                          "wrap": true
                        }
                      ]
                    },
                    {
                      "type": "Column",
                      "width": "130px",
                      "items": [
                        {
                          "type": "TextBlock",
                          "text": "Amount",
                          "size": "Small",
                          "isSubtle": true,
                          "weight": "Bolder",
                          "horizontalAlignment": "Right",
                          "wrap": true
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Container",
          "$data": "${items}",
          "spacing": "Small",
          "items": [
            {
              "type": "ColumnSet",
              "spacing": "None",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${description}",
                      "weight": "Bolder",
                      "wrap": true,
                      "spacing": "None"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "200px",
                  "items": [
                    {
                      "type": "ColumnSet",
                      "columns": [
                        {
                          "type": "Column",
                          "width": "70px",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "${quantity} ${unit}",
                              "horizontalAlignment": "Center",
                              "wrap": true,
                              "spacing": "None"
                            }
                          ]
                        },
                        {
                          "type": "Column",
                          "width": "130px",
                          "items": [
                            {
                              "type": "TextBlock",
                              "text": "${netValue} ${currency}",
                              "weight": "Bolder",
                              "horizontalAlignment": "Right",
                              "wrap": true,
                              "spacing": "None"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "ColumnSet",
              "spacing": "None",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${itemCodeLabel}",
                      "size": "Small",
                      "isSubtle": true,
                      "wrap": true,
                      "spacing": "None"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "200px",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${unitPriceLabel}",
                      "size": "Small",
                      "isSubtle": true,
                      "horizontalAlignment": "Center",
                      "wrap": true,
                      "spacing": "None"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Request release",
      "style": "positive",
      "$when": "${showRequestRelease == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Request release ${salesOrderNumber}",
          "text": "request release ${salesOrderNumber}"
        },
        "action": "release_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Update reference",
      "$when": "${showUpdateReference == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Update reference ${salesOrderNumber}",
          "text": "update reference ${salesOrderNumber}"
        },
        "action": "update_ref",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Edit order",
      "$when": "${showEditOrder == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Edit order ${salesOrderNumber}",
          "text": "edit order ${salesOrderNumber}"
        },
        "action": "edit_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Approve & release",
      "style": "positive",
      "$when": "${showApprove == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Approve order ${salesOrderNumber}",
          "text": "approve order ${salesOrderNumber}"
        },
        "action": "approve_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel order",
      "style": "destructive",
      "$when": "${showCancel == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Cancel order ${salesOrderNumber}",
          "text": "cancel order ${salesOrderNumber}"
        },
        "action": "cancel_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Reject order",
      "style": "destructive",
      "$when": "${showReject == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Reject order ${salesOrderNumber}",
          "text": "reject order ${salesOrderNumber}"
        },
        "action": "reject_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Forward",
      "$when": "${showForward == 'true'}",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Forward order ${salesOrderNumber}",
          "text": "forward order ${salesOrderNumber}"
        },
        "action": "forward_so",
        "salesOrderId": "${salesOrderNumber}"
      }
    }
  ]
}