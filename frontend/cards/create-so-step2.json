{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Create sales order (Step 2 of 3)",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Selected Sales Area: ${salesAreaLabel}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "customer",
      "label": "Select Customer",
      "style": "compact",
      "isRequired": false,
      "value": "${customer}",
      "choices": [
        {
          "$data": "${customerChoices}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "manualCustomer",
      "label": "Customer not in list? Type the customer number (e.g. 135001 or 0000135001)",
      "placeholder": "135001",
      "isRequired": false,
      "regex": "^0*[0-9]{1,10}$",
      "errorMessage": "Customer must be 1-10 digits"
    },
    {
      "type": "TextBlock",
      "text": "Either pick from the dropdown above OR enter a customer number below. If both are filled, the typed value wins.",
      "size": "Small",
      "isSubtle": true,
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Next",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Next step",
          "text": "Next"
        },
        "action": "create_so_step2_submit",
        "salesArea": "${salesAreaKey}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
