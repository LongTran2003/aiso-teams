{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Delegate approval authority",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Select a manager, valid dates, max amount and optional reason.",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "delegateUser",
      "label": "Delegate to (Manager)",
      "style": "compact",
      "isRequired": true,
      "errorMessage": "Delegate user is required",
      "value": "${delegateUser}",
      "choices": [
        {
          "$data": "${managerChoices}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Date",
              "id": "validFromRaw",
              "label": "Valid from",
              "isRequired": true,
              "errorMessage": "Valid from date is required",
              "value": "${validFromRaw}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Date",
              "id": "validToRaw",
              "label": "Valid to",
              "isRequired": true,
              "errorMessage": "Valid to date is required",
              "value": "${validToRaw}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Text",
              "id": "maxAmountRaw",
              "label": "Max amount (Optional)",
              "placeholder": "e.g. 10000000",
              "value": "${maxAmountRaw}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "90px",
          "items": [
            {
              "type": "Input.ChoiceSet",
              "id": "currency",
              "label": "Currency",
              "style": "compact",
              "value": "${currency}",
              "choices": [
                {
                  "title": "VND",
                  "value": "VND"
                },
                {
                  "title": "USD",
                  "value": "USD"
                },
                {
                  "title": "EUR",
                  "value": "EUR"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "reason",
      "label": "Reason (Optional)",
      "placeholder": "e.g. Annual leave / Vacation context...",
      "isMultiline": true,
      "value": "${reason}"
    },
    {
      "type": "TextBlock",
      "text": "During this period, the delegated user will be able to approve sales orders on your behalf.",
      "wrap": true,
      "size": "Small",
      "isSubtle": true,
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Confirm Delegation",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm delegation",
          "text": "delegate confirm"
        },
        "action": "delegate_confirm",
        "delegateUser": "${delegateUser}",
        "validFromRaw": "${validFromRaw}",
        "validToRaw": "${validToRaw}",
        "maxAmountRaw": "${maxAmountRaw}",
        "currency": "${currency}",
        "reason": "${reason}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}