{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "KPI by product",
      "size": "Large",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${count} product(s)",
      "size": "Small",
      "isSubtle": true,
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "Image",
      "url": "${chartUrl}",
      "altText": "Top products by revenue",
      "spacing": "Medium",
      "horizontalAlignment": "Center",
      "size": "Medium",
      "$when": "${chartUrl != ''}"
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "Medium",
      "$data": "${products}",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "Medium",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${materialName}",
                  "weight": "Bolder",
                  "wrap": true,
                  "spacing": "None"
                },
                {
                  "type": "TextBlock",
                  "text": "${materialId}",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                },
                {
                  "type": "TextBlock",
                  "text": "Qty ${formattedQty} · ${orderCount} line(s)",
                  "size": "Small",
                  "isSubtle": true,
                  "spacing": "None",
                  "wrap": true
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${formattedRevenue}",
                  "weight": "Bolder",
                  "horizontalAlignment": "Right",
                  "wrap": true,
                  "spacing": "None"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
