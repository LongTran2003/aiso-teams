{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Attention",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Confirm action",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Attention"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Are you sure you want to reject sales order ${salesOrderNumber}?",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "This action cannot be undone once confirmed.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "reasonCode",
      "label": "Select a reason for rejection",
      "isRequired": true,
      "errorMessage": "Please select a reason",
      "choices": [
        {
          "title": "Too expensive",
          "value": "PRICE_ISSUE"
        },
        {
          "title": "Not in stock",
          "value": "OUT_OF_STOCK"
        },
        {
          "title": "Other / Customer Cancellation",
          "value": "OTHER"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Confirm Reject",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm reject order ${salesOrderNumber}",
          "text": "reject order ${salesOrderNumber}"
        },
        "action": "reject_so_confirm",
        "salesOrderId": "${salesOrderNumber}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}