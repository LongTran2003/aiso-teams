        "action": "create_so_step3_submit",
        "salesArea": "${salesAreaKey}",
        "salesOrg": "${salesOrg}",
        "distChannel": "${distChannel}",
        "division": "${division}",
        "docType": "${docType}",
        "currency": "${currency}",
        "purchaseOrderRef": "${purchaseOrderRef}",
        "requestedDeliveryDate": "${requestedDeliveryDate}",
        "shipToParty": "${shipToParty}",
        "customer": "${customer}",
