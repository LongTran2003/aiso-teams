{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Create sales order (Step 3 of 3)",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Customer: ${customerLabel}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "currency",
      "label": "Currency",
      "placeholder": "e.g. USD",
      "value": "${currency}"
    },
    {
      "type": "TextBlock",
      "text": "Line items",
      "spacing": "Medium",
      "size": "Small"
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.ChoiceSet", "id": "material1", "label": "Material 1", "isRequired": true, "errorMessage": "At least one material is required", "value": "${material1}", "choices": [ { "$data": "${materialChoices}", "title": "${title}", "value": "${value}" } ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty1",
              "label": "Qty",
              "isRequired": true,
              "errorMessage": "Qty required",
              "min": 1,
              "value": "${qty1}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material2",
                "label": "Material 2",
                "value": "${material2}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty2",
              "label": "Qty",
              "min": 0,
              "value": "${qty2}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material3",
                "label": "Material 3",
                "value": "${material3}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty3",
              "label": "Qty",
              "min": 0,
              "value": "${qty3}"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Create order",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm create order",
          "text": "create order"
        },
        "action": "create_so_confirm",
        "salesArea": "${salesAreaKey}",
        "customer": "${customerKey}",
        "plant": "${plant}",
        "unit": "${unit}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
