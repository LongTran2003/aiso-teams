{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Create sales order (Step 1 of 3)",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "salesArea",
      "label": "Select Sales Area (Org / Channel / Division)",
      "style": "compact",
      "isRequired": true,
      "errorMessage": "Sales area is required",
      "value": "${salesArea}",
      "choices": [
        {
          "$data": "${salesAreaChoices}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Next",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Next step",
          "text": "Next"
        },
        "action": "create_so_step1_submit"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
