{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Attention",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "No results",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Attention",
          "wrap": true
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Nothing matched this request.",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "Try another order number or broaden the search. Example commands: recent orders · show open orders of TV01 · show order 13122. Type help for the full list for your role.",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Show help",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "help",
          "text": "help"
        }
      }
    }
  ]
}
