{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Create sales order",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Pick a customer (includes sales area). Up to 8 materials.",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "customer",
      "label": "Customer (with sales area)",
      "style": "compact",
      "isRequired": true,
      "errorMessage": "Customer is required",
      "value": "${customer}",
      "choices": [
        {
          "$data": "${customerChoices}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "salesArea",
      "label": "Sales area (org / channel / division)",
      "style": "compact",
      "isRequired": true,
      "errorMessage": "Sales area is required",
      "value": "${salesArea}",
      "choices": [
        {
          "$data": "${salesAreaChoices}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "currency",
      "label": "Currency",
      "placeholder": "e.g. USD",
      "value": "${currency}"
    },
    {
      "type": "TextBlock",
      "text": "Line items",
      "weight": "Bolder",
      "spacing": "Medium",
      "size": "Small"
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.ChoiceSet", "id": "material1", "label": "Material 1", "isRequired": true, "errorMessage": "At least one material is required", "value": "${material1}", "choices": [ { "$data": "${materialChoices}", "title": "${title}", "value": "${value}" } ]
            }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty1",
              "label": "Qty",
              "isRequired": true,
              "errorMessage": "Qty required",
              "min": 1,
              "value": "${qty1}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material2",
                "label": "Material 2",
                "value": "${material2}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty2",
              "label": "Qty",
              "min": 0,
              "value": "${qty2}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material3",
                "label": "Material 3",
                "value": "${material3}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty3",
              "label": "Qty",
              "min": 0,
              "value": "${qty3}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material4",
                "label": "Material 4",
                "value": "${material4}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty4",
              "label": "Qty",
              "min": 0,
              "value": "${qty4}"
            }
          ]
        }
      ]
    },

    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material5",
                "label": "Material 5",
                "value": "${material5}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty5",
              "label": "Qty",
              "min": 0,
              "value": "${qty5}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material6",
                "label": "Material 6",
                "value": "${material6}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty6",
              "label": "Qty",
              "min": 0,
              "value": "${qty6}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material7",
                "label": "Material 7",
                "value": "${material7}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty7",
              "label": "Qty",
              "min": 0,
              "value": "${qty7}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
                "type": "Input.ChoiceSet",
                "id": "material8",
                "label": "Material 8",
                "value": "${material8}",
                "choices": [
                  {
                    "$data": "${materialChoices}",
                    "title": "${title}",
                    "value": "${value}"
                  }
                ]
              }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty8",
              "label": "Qty",
              "min": 0,
              "value": "${qty8}"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Create order",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm create order",
          "text": "create order"
        },
        "action": "create_so_confirm",
        "plant": "${plant}",
        "unit": "${unit}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}

