{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "style": "Accent",
      "bleed": true,
      "items": [
        {
          "type": "TextBlock",
          "text": "Create sales order",
          "weight": "Bolder",
          "size": "Medium",
          "color": "Accent",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "Pick a customer (includes sales area). Up to 5 materials.",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None",
          "wrap": true
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "customer",
      "label": "Customer (with sales area)",
      "style": "compact",
      "isRequired": true,
      "errorMessage": "Customer is required",
      "value": "${customer}",
      "choices": [
        {
          "$data": "${customerChoices}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "salesArea",
      "label": "Sales area (org / channel / division)",
      "style": "compact",
      "isRequired": true,
      "errorMessage": "Sales area is required",
      "value": "${salesArea}",
      "choices": [
        {
          "$data": "${salesAreaChoices}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "currency",
      "label": "Currency",
      "placeholder": "e.g. USD",
      "value": "${currency}"
    },
    {
      "type": "TextBlock",
      "text": "Line items",
      "weight": "Bolder",
      "spacing": "Medium",
      "size": "Small"
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Text",
              "id": "material1",
              "label": "Material 1",
              "isRequired": true,
              "errorMessage": "At least one material is required",
              "placeholder": "e.g. TG11",
              "value": "${material1}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty1",
              "label": "Qty",
              "isRequired": true,
              "errorMessage": "Qty required",
              "min": 1,
              "value": "${qty1}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Text",
              "id": "material2",
              "label": "Material 2",
              "placeholder": "Optional",
              "value": "${material2}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty2",
              "label": "Qty",
              "min": 0,
              "value": "${qty2}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Text",
              "id": "material3",
              "label": "Material 3",
              "placeholder": "Optional",
              "value": "${material3}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty3",
              "label": "Qty",
              "min": 0,
              "value": "${qty3}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Text",
              "id": "material4",
              "label": "Material 4",
              "placeholder": "Optional",
              "value": "${material4}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty4",
              "label": "Qty",
              "min": 0,
              "value": "${qty4}"
            }
          ]
        }
      ]
    },
    {
      "type": "ColumnSet",
      "spacing": "Small",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "Input.Text",
              "id": "material5",
              "label": "Material 5",
              "placeholder": "Optional",
              "value": "${material5}"
            }
          ]
        },
        {
          "type": "Column",
          "width": "80px",
          "items": [
            {
              "type": "Input.Number",
              "id": "qty5",
              "label": "Qty",
              "min": 0,
              "value": "${qty5}"
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Create order",
      "style": "positive",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "Confirm create order",
          "text": "create order"
        },
        "action": "create_so_confirm",
        "plant": "${plant}",
        "unit": "${unit}"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Cancel",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "cancel",
          "text": "cancel"
        }
      }
    }
  ]
}
