{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "📈 Revenue Overview",
      "weight": "Bolder",
      "size": "Medium",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "Monthly revenue summary for ${period}",
      "wrap": true,
      "isSubtle": true,
      "spacing": "Small"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Total Revenue:", "value": "${totalRevenue}" },
        { "title": "Growth:", "value": "${growthRate}" },
        { "title": "Target:", "value": "${targetRevenue}" }
      ],
      "spacing": "Medium"
    },
    {
      "type": "Image",
      "url": "${chartUrl}",
      "altText": "Revenue chart",
      "spacing": "Medium",
      "horizontalAlignment": "Center",
      "$when": "${chartUrl != ''}"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "View Revenue Details",
      "data": {
        "msteams": {
          "type": "messageBack",
          "displayText": "View Revenue KPI Dashboard",
          "text": "show revenue kpi"
        }
      }
    }
  ]
}