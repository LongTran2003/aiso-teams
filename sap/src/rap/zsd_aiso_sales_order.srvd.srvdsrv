@EndUserText.label: 'AISO Sales Order Service Definition'
define service ZSD_AISO_SALES_ORDER {
  expose ZC_AISO_SO_WITH_ITEMS as SalesOrder;
  expose ZI_AISO_KPI_SO_AGING as KpiSoAging;
  expose ZI_AISO_KPI_DELIVERY as KpiDelivery;
  expose ZI_AISO_KPI_AR_AGING as KpiArAging;
  expose ZI_AISO_KPI_REVENUE as KpiRevenue;
  expose ZI_AISO_SO_ITEM as SalesOrderItem;
  expose ZI_AISO_KPI_BY_CUSTOMER as KpiByCustomer;
  expose ZI_AISO_KPI_BY_PRODUCT as KpiByProduct;
  expose ZI_AISO_USER_ROLE as UserRole;
  expose ZI_AISO_VALID_CUSTOMER as ValidCustomer;
  expose ZI_AISO_SALES_AREA as SalesArea;
  expose ZI_AISO_VALID_MATERIAL as ValidMaterial;
  expose ZI_AISO_VALID_MATERIAL_PLANT as ValidMaterialPlant;
  expose ZC_AISO_MATERIAL as Material;
  expose ZC_AISO_SO_ITEM as SalesOrderItems;
  expose ZC_AISO_VALID_MATERIAL_SALES as ValidMaterialSales;
  expose ZC_AISO_USER_ROLE_QUERY as UserRoles;
  expose ZC_AISO_SALES_ORG_LIST as SalesOrgList;
  expose ZC_AISO_DIST_CHANNEL_LIST as DistChannelList;
  expose ZC_AISO_DIVISION_LIST as DivisionList;
  expose ZC_AISO_DOC_TYPE_LIST as DocTypeList;
}