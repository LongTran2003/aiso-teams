define behavior for ZI_AISO_SO_ITEM alias SalesOrderItem
late numbering
lock dependent by _Header
authorization dependent by _Header
{
  create;
  field ( readonly ) SoNumber, ItemNo;
  field ( mandatory ) Material, Plant, OrderQty, Unit;

  association _Header;
}